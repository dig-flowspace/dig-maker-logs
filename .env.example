# Copy to .env and fill in. .env is gitignored — secrets never leave this machine.

# ---- Reddit API (https://www.reddit.com/prefs/apps) ----
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=the-workshop/0.1 by u/your_username
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=change-me
